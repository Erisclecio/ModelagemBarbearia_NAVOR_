Table PESSOA {
  cpf CHAR(11) [pk, not null]
  id_pessoa int [unique, not null]
  nome VARCHAR(80)
  email VARCHAR(70)
  data_cadastro datetime
}

Table PESSOA_TELEFONE{
  id_pessoa int [not null]
  telefone char(11) [not null]

indexes {
  (id_pessoa, telefone) [pk]
}
}
Table CLIENTE {
  id_cliente int [pk]
  id_pessoa int [unique, not null]
}

// possui_telefone
Ref: PESSOA_TELEFONE.id_pessoa > PESSOA.id_pessoa

// assume
Ref: PESSOA.id_pessoa -? CLIENTE.id_pessoa

Enum situacao_funcionario {
  ATIVO
  INATIVO
  AFASTADO
  FERIAS
}
Table FUNCIONARIO {
  id_funcionario int [pk]
  id_pessoa int [unique, not null]
  funcao VARCHAR(40)
  presta_servico boolean
  situacao situacao_funcionario
  comissionado bool
}


// exerce
Ref: PESSOA.id_pessoa -? FUNCIONARIO.id_pessoa

Enum status_usuario {
  ATIVO
  INATIVO
  BLOQUEADO
}
Table USUARIO {
  id_usuario int [pk]
  id_funcionario int [unique, not null]
  id_perfil int [not null]
  login varchar(12) [unique, not null]
  senha varchar(255) [not null]
  status status_usuario
}


// autentica-se
Ref: FUNCIONARIO.id_funcionario -? USUARIO.id_funcionario
// segue
Ref: USUARIO.id_perfil ?> PERFIL_ACESSO.id_perfil

Enum situacao_perfil_enum{
  ATIVO
  INATIVO
  BLOQUEADO
}
Table PERFIL_ACESSO {
  id_perfil int [pk]
  nome_perfil varchar(20)
  descricao_perfil text
  situacao_perfil situacao_perfil_enum
}

Table PREFERENCIA {
  id_cliente int [pk]
  horario_preferido time
  corte_preferido varchar(15)
  id_funcionario_preferencial int
  observacao_preferencia text
}
// possui
Ref: CLIENTE.id_cliente -? PREFERENCIA.id_cliente
// indica
Ref: PREFERENCIA.id_funcionario_preferencial ?>? FUNCIONARIO.id_funcionario

Enum situacao_servico{
  ATIVO
  INATIVO
}
Table SERVICO {
  id_servico int [pk]
  nome VARCHAR(60)
  duracao_estimada int 
  preco_atual decimal(10,2)
  situacao situacao_servico
}

Enum situacao_produto{
  ATIVO
  INATIVO
}

Table PRODUTO {
  id_produto int [pk]
  nome varchar(50)
  descricao text
  preco_venda decimal(10,2)
  estoque_minimo int
  situacao situacao_produto
}

Enum status_fornecedor {
  ATIVO
  INATIVO
}
Enum documento_fornecedor {
  CPF
  CNPJ
}
Table FORNECEDOR {
  id_fornecedor int [pk]
  tipo_documento documento_fornecedor
  numero_documento varchar(14)
  nome varchar(120)
  email varchar(120)
  status status_fornecedor
}

Table FORNECEDOR_TELEFONE {
  id_fornecedor int [not null]
  telefone char(11) [not null]

  indexes {
    (id_fornecedor, telefone) [pk]
  }
}

// possui_telefone
Ref: FORNECEDOR_TELEFONE.id_fornecedor > FORNECEDOR.id_fornecedor

Enum status_agendamento{
  PENDENTE
  EM_EXECUCAO
  FINALIZADO
  CANCELADO
  CONFIRMADO
}
Table AGENDAMENTO {
  id_agendamento int [pk]
  id_cliente int [not null]
  id_funcionario int [not null]
  data_hora_inicio datetime
  duracao_prevista int 
  status status_agendamento
}

// solicita
Ref: AGENDAMENTO.id_cliente ?> CLIENTE.id_cliente
// atende
Ref: AGENDAMENTO.id_funcionario ?> FUNCIONARIO.id_funcionario

Table ATENDIMENTO {
  id_atendimento int [pk]
  id_agendamento int [unique]
  id_cliente int [not null]
  id_funcionario int [not null]
  data_hora_atendimento datetime
  valor_total decimal(10,2)
}

// origina
Ref: AGENDAMENTO.id_agendamento ?-? ATENDIMENTO.id_agendamento
// participa
Ref: ATENDIMENTO.id_cliente ?> CLIENTE.id_cliente
// executa
Ref: ATENDIMENTO.id_funcionario ?> FUNCIONARIO.id_funcionario

Table VENDA {
  id_venda int [pk]
  id_cliente int [not null]
  data_hora_venda datetime
  valor_total decimal(10,2)
}
// efetua_compra
Ref: VENDA.id_cliente ?> CLIENTE.id_cliente

Enum status_compra{
  EM_TRANSITO
  ENTREGUE
  ENTREGUE_PARCIAL
  RECUSADA
}

Table COMPRA {
  id_compra int [pk]
  id_fornecedor int [not null]
  data_compra date
  situacao_recebimento status_compra
  valor_total decimal(10,2)
}
// supre
Ref: COMPRA.id_fornecedor ?> FORNECEDOR.id_fornecedor

Enum status_pagamento {
  PENDENTE
  CONFIRMADO
  RECUSADO
  ESTORNADO
}

Table PAGAMENTO {
  id_pagamento int [pk]
  id_conta_receber int [not null]
  id_forma_pagamento int [not null]
  valor decimal(10,2)
  situacao_pagamento status_pagamento
  data_hora_confirmacao datetime
  data_hora_estorno datetime
  data_hora_pagamento datetime
}

// utiliza
Ref: PAGAMENTO.id_forma_pagamento ?> FORMA_PAGAMENTO.id_forma_pagamento
// recebe_pagamentos
Ref: PAGAMENTO.id_conta_receber ?> CONTA_RECEBER.id_conta_receber

Enum status_forma_pagamento{
  ATIVO
  INATIVO
}
Table FORMA_PAGAMENTO {
  id_forma_pagamento int [pk]
  nome varchar(30)
  situacao status_forma_pagamento
}

Enum tipos_movimentacao {
  ENTRADA
  SAIDA
}
Enum origens_movimentacao {
  COMPRA
  VENDA
  CONSUMO_ATENDIMENTO
  PERDA
  AJUSTE
}

Table MOVIMENTACAO_ESTOQUE {
  id_movimentacao int [pk]
  id_produto int [not null]
  tipo_movimentacao tipos_movimentacao [not null]
  quantidade int [not null]
  origem_movimentacao origens_movimentacao [not null]
  data_hora_movimentacao datetime [not null]
  id_compra int
  id_venda int
  id_atendimento int
  id_movimentacao_relacionada int

  indexes {
    (id_venda, id_produto) [unique]
    (id_atendimento, id_produto) [unique]
  }

}

// movimenta
Ref: MOVIMENTACAO_ESTOQUE.id_produto ?> PRODUTO.id_produto
// rastreia_recebimento
Ref: MOVIMENTACAO_ESTOQUE.(id_compra, id_produto) ?>? ITEM_COMPRA.(id_compra, id_produto)
// rastreia_venda
Ref: ITEM_VENDA.(id_venda, id_produto) ?-? MOVIMENTACAO_ESTOQUE.(id_venda, id_produto)
// rastreia_consumo
Ref: ATENDIMENTO_PRODUTO.(id_atendimento, id_produto) ?- MOVIMENTACAO_ESTOQUE.(id_atendimento, id_produto)
// referencia_movimentacao
Ref: MOVIMENTACAO_ESTOQUE.id_movimentacao_relacionada ?>? MOVIMENTACAO_ESTOQUE.id_movimentacao

Enum tipo_periodo_jornada {
  TRABALHO
  INTERVALO
  FOLGA
}

Enum dias_trabalho{
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
}

Table JORNADA_FUNCIONARIO {
  id_funcionario int [not null]
  dia_semana dias_trabalho
  hora_inicio time
  hora_fim time
  tipo_periodo tipo_periodo_jornada

  indexes {
    (id_funcionario, dia_semana, hora_inicio) [pk]
  }
}

// cumpre
Ref: JORNADA_FUNCIONARIO.id_funcionario ?> FUNCIONARIO.id_funcionario

Enum operacoes{
  INCLUSAO
  ALTERACAO
  EXCLUSAO
}

Table REGISTRO_AUDITORIA {
  id_registro int [pk]
  id_usuario int [not null]
  data_hora_auditoria datetime
  operacao operacoes
  objeto_afetado VARCHAR(30)
}

// gera
Ref: REGISTRO_AUDITORIA.id_usuario ?> USUARIO.id_usuario

Table ITEM_ATENDIMENTO {
  id_item_atendimento int [pk]
  id_atendimento int [not null]
  id_servico int [not null]
  preco_praticado decimal(10,2)
}
// detalha
Ref: ITEM_ATENDIMENTO.id_atendimento > ATENDIMENTO.id_atendimento
// compoe_atendimento
Ref: ITEM_ATENDIMENTO.id_servico ?> SERVICO.id_servico


Table ITEM_VENDA {
  id_venda int [not null]
  id_produto int [not null]
  qtd_venda int
  preco_unitario_praticado decimal(10,2)
  indexes {
    (id_venda, id_produto) [pk]
  }
}

// discrimina
Ref: ITEM_VENDA.id_venda > VENDA.id_venda
// compoe_venda
Ref: ITEM_VENDA.id_produto ?> PRODUTO.id_produto

Table ITEM_COMPRA {
  id_compra int [not null]
  id_produto int [not null]
  qtd_compra int
  qtd_recebida int
  custo_unitario decimal(10,2)

  indexes {
    (id_compra, id_produto) [pk]
  }
}
// detalha_aquisicao
Ref: ITEM_COMPRA.id_compra > COMPRA.id_compra
// compoe_compra
Ref: ITEM_COMPRA.id_produto ?> PRODUTO.id_produto

Table COMISSAO {
  id_comissao int [pk]
  id_item_atendimento int [unique, not null]
  percentual_aplicado decimal(10,2)
  valor_comissao decimal(10,2)
  situacao_comissao varchar(20)
  mes_ano_comissao varchar(7)
}
// produz_comissao
Ref: ITEM_ATENDIMENTO.id_item_atendimento -? COMISSAO.id_item_atendimento

Table AGENDAMENTO_SERVICO {
  id_agendamento int [not null]
  id_servico int [not null]
  qtd_servico int

  indexes {
    (id_agendamento, id_servico) [pk]
  }
}
// seleciona
Ref: AGENDAMENTO_SERVICO.id_agendamento > AGENDAMENTO.id_agendamento
// integra_agendamento
Ref: AGENDAMENTO_SERVICO.id_servico ?> SERVICO.id_servico

Table FUNCIONARIO_SERVICO {
  id_funcionario int [not null]
  id_servico int [not null]

  indexes {
    (id_funcionario, id_servico) [pk]
  }
}
// habilita
Ref: FUNCIONARIO_SERVICO.id_funcionario ?> FUNCIONARIO.id_funcionario
// referencia_habilitacao
Ref: FUNCIONARIO_SERVICO.id_servico ?> SERVICO.id_servico

Table ATENDIMENTO_PRODUTO {
  id_atendimento int [not null]
  id_produto int [not null]
  qtd_consumida int

  indexes {
    (id_atendimento, id_produto) [pk]
  }
}

// registra_consumo
Ref: ATENDIMENTO_PRODUTO.id_atendimento ?> ATENDIMENTO.id_atendimento
// e_consumido_em
Ref: ATENDIMENTO_PRODUTO.id_produto ?> PRODUTO.id_produto
Table CONTA_RECEBER {
  id_conta_receber int [pk]
  id_atendimento int [unique]
  id_venda int [unique]
  valor_original decimal(10,2)
  data_emissao date
  data_vencimento date
  situacao situacao_conta
  saldo_pendente decimal(10,2) 

}


// fundamenta_recebivel
Ref: ATENDIMENTO.id_atendimento ?-? CONTA_RECEBER.id_atendimento
// constitui_credito
Ref: VENDA.id_venda ?-? CONTA_RECEBER.id_venda

Enum situacao_conta{
  EM_ABERTO
  PAGO
  CANCELADO
  ESTORNADO
}

Table CONTA_PAGAR {
  id_conta_pagar int [pk]
  id_compra int [unique, not null]
  valor_original_compra decimal(10,2)
  data_emissao_compra date
  data_vencimento_compra date
  situacao_compra situacao_conta
  saldo_pendente_compra decimal(10,2)
}

// estabelece_obrigacao
Ref: COMPRA.id_compra -? CONTA_PAGAR.id_compra

Enum meio_pagamento_fornecedor{
  PIX
  BOLETO
  TRANSFERENCIA
  DINHEIRO
  CARTAO
}

Enum situacao_pagamento_fornecedor {
  PENDENTE
  CONFIRMADO
  CANCELADO
  ESTORNADO
}

Table PAGAMENTO_FORNECEDOR {
  id_pagamento_fornecedor int [pk]
  id_conta_pagar int [not null]
  valor_pago decimal(10,2)
  data_hora_pagamento datetime
  meio_pagamento meio_pagamento_fornecedor
  situacao_pagamento situacao_pagamento_fornecedor
  referencia_comprovante text
  data_hora_confirmacao datetime
}

// registra_pagamento_fornecedor
Ref: PAGAMENTO_FORNECEDOR.id_conta_pagar ?> CONTA_PAGAR.id_conta_pagar

Enum tipo_mov_caixa{
  ENTRADA
  SAIDA
}


Table MOVIMENTACAO_CAIXA {
  id_movimentacao_caixa int [pk]
  id_pagamento int [unique]
  id_pagamento_fornecedor int [unique]
  tipo_movimentacao tipo_mov_caixa [not null]
  valor_movimentacao decimal(10,2) [not null]
  data_hora_movimentacao datetime [not null]
  descricao_movimentacao varchar(100)
  id_movimentacao_estornada int

}


// provoca_entrada
Ref: PAGAMENTO.id_pagamento ?-? MOVIMENTACAO_CAIXA.id_pagamento
// provoca_saida
Ref: PAGAMENTO_FORNECEDOR.id_pagamento_fornecedor ?-? MOVIMENTACAO_CAIXA.id_pagamento_fornecedor
// estorna
Ref: MOVIMENTACAO_CAIXA.id_movimentacao_estornada ?>? MOVIMENTACAO_CAIXA.id_movimentacao_caixa

Enum situacao_conciliacao {
  PENDENTE
  CONCILIADA
  DIVERGENTE
}

Table CONCILIACAO_FINANCEIRA {
  id_conciliacao int [pk]
  id_movimentacao_caixa int [not null]
  id_usuario int [not null]
  data_conciliacao date
  referencia_conciliacao varchar(100)
  valor_conferido_conciliacao decimal(10,2)
  situacao_conciliacao situacao_conciliacao
  observacao_divergencia text
}

// e_submetida_a
Ref: CONCILIACAO_FINANCEIRA.id_movimentacao_caixa ?> MOVIMENTACAO_CAIXA.id_movimentacao_caixa
// confere
Ref: CONCILIACAO_FINANCEIRA.id_usuario ?> USUARIO.id_usuario